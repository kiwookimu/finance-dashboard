{
  "name": "finance-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Mobile-first market indicator dashboard with delayed public market data.",
  "scripts": {
    "backtest": "node scripts/backtest_signals.mjs",
    "backtest:index": "node scripts/backtest_index_predictions.mjs",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "start": "node server-runner.cjs",
    "start:sites": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "node --test tests/*.test.mjs",
    "screen:kospi": "node scripts/screen_mfi_volume.mjs 2026-04 5 KOSPI true",
    "screen:kr-breakout": "node scripts/screen_kr_monthly_breakout.mjs 2026-05",
    "screen:us": "node scripts/screen_us_mfi_volume.mjs 2026-04 5 true",
    "screen:us-breakout": "node scripts/screen_us_monthly_breakout.mjs 2025-09"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
